# Sao chép thành .env rồi điền thông tin. KHÔNG commit file .env.

# --- Dữ liệu
STOCK_DB_PATH=data/stock.db
STOCK_SOURCES=VCI,DNSE,KBS
STOCK_POLL_SECONDS=60
STOCK_HISTORY_YEARS=10
# Chạy worker cảnh báo kèm giao diện (app.py). Đặt false nếu chỉ muốn chạy worker riêng.
STOCK_EMBED_WORKER=true

# --- Email (SMTP). Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng".
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Nhiều người nhận, cách nhau bởi dấu phẩy
SMTP_TO=

# --- Thông báo Windows
TOAST_ENABLED=true
TOAST_APP_ID=Chứng khoán VN

# --- Thông báo trình duyệt (Web Push)
# Để trống: app tự sinh khóa VAPID và lưu trong CSDL. Nên đặt cố định khi CSDL có thể bị xóa
# (vd. Streamlit Cloud), nếu không trình duyệt phải bật lại sau mỗi lần đổi khóa. Tạo khóa:
#   python -c "from stockvn.webpush import generate_private_key; print(generate_private_key())"
WEBPUSH_VAPID_PRIVATE_KEY=
# Liên hệ gửi kèm cho dịch vụ push (mailto: hoặc https:). Mặc định: mailto:SMTP_FROM
WEBPUSH_SUBJECT=

# --- ntfy (https://ntfy.sh): nhận trên app ntfy (Android/iOS) hoặc web app ntfy, không cần tài khoản.
# Topic có tác dụng như mật khẩu: ai biết đều đọc/gửi được -> đặt chuỗi ngẫu nhiên, dài. Tạo topic:
#   python -c "import secrets; print('stockvn-' + secrets.token_hex(12))"
NTFY_TOPIC=
# Máy chủ ntfy tự host (mặc định https://ntfy.sh) và access token nếu topic được bảo vệ
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
